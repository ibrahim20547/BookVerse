# ==========================================
# BookVerse Production Environment Variables
# ==========================================

# 1. Database Connection URL
# For production (Vercel), use a hosted PostgreSQL instance (e.g. Neon, Supabase, Vercel Postgres, Render, Railway)
# Example: postgresql://username:password@ep-sample-12345.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?sslmode=require

# 2. JWT Secret Key
# A random secret string used to sign authentication tokens
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_here

# 3. Frontend API URL (Optional)
# Leave empty on Vercel to use the default relative '/api' endpoint.
# Set only if backend is hosted on a separate custom domain.
# VITE_API_URL=https://your-api-domain.com/api
